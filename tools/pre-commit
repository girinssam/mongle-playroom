#!/bin/sh
# 몽글몽글 놀이방 커밋 전 확인 (git pre-commit 훅). 설치 방법은 CLAUDE.md '커밋 전 확인 훅'.
#  1) index.html의 APP_VERSION과 version.json의 v가 같은지
#  2) 글꼴 서브셋에 빠진 글자가 없는지 (tools/font-subset.cjs --check)
# 둘 다 커밋에 들어갈 내용(스테이징된 파일)으로 확인해요. 하나라도 걸리면 커밋을 막아요.
# 정말 급할 때만: git commit --no-verify (확인 없이 커밋)

TOOLS="${MONGLE_TOOLS:-$HOME/.mongle-tools}"   # fontkit이 설치된 폴더
ROOT="$(git rev-parse --show-toplevel)" || exit 1
TMP="$(mktemp -d)" || exit 1
trap 'rm -rf "$TMP"' EXIT

# 커밋에 들어갈 파일만 임시 폴더로 꺼내기
mkdir -p "$TMP/fonts"
for f in index.html version.json voice-list.csv fonts/jua.woff2 fonts/gowun-dodum.woff2 fonts/not-in-font.json; do
  git cat-file -e ":$f" 2>/dev/null && git show ":$f" > "$TMP/$f"
done

fail=0

# 1) 버전 확인
node -e '
const fs=require("fs"),d=process.argv[1];
const app=(fs.readFileSync(d+"/index.html","utf8").match(/const APP_VERSION=\x27([^\x27]+)\x27/)||[])[1];
let v;try{v=JSON.parse(fs.readFileSync(d+"/version.json","utf8")).v}catch(e){}
if(!app||!v||app!==v){console.log("[커밋 막음] 버전이 서로 달라요: index.html APP_VERSION="+app+" / version.json v="+v);console.log("  두 값을 같은 새 값으로 맞춰 주세요 (CLAUDE.md \x27버전 올리기 규칙\x27).");process.exit(1)}
console.log("버전 확인: "+app+" (같음)");
' "$TMP" || fail=1

# 2) 글꼴 빠진 글자 확인
if [ ! -d "$TOOLS/node_modules/fontkit" ]; then
  echo "[커밋 막음] 글꼴 확인 도구가 없어요: $TOOLS/node_modules/fontkit"
  echo "  설치: mkdir -p ~/.mongle-tools && cd ~/.mongle-tools && echo '{\"name\":\"mongle-tools\",\"private\":true}' > package.json && npm i subset-font fontkit"
  fail=1
else
  out="$(cd "$TOOLS" && node "$ROOT/tools/font-subset.cjs" "$TMP" --check 2>&1)"
  code=$?
  if [ $code -ne 0 ]; then
    echo "$out" | grep -v '(참고)'
    echo "[커밋 막음] 글꼴에 빠진 글자가 있어요. 위의 글자를 넣어 서브셋을 다시 만들어 주세요 (CLAUDE.md '글꼴')."
    echo "  다시 만들기: cd $TOOLS && node \"$ROOT/tools/font-subset.cjs\" \"$ROOT\" Jua-Regular.ttf GowunDodum-Regular.ttf"
    fail=1
  else
    echo "글꼴 확인: 빠진 글자 없음"
  fi
fi

exit $fail
